# --- Server ---
SMB_HOST=127.0.0.1
SMB_PORT=8080
SMB_ENV=dev
SMB_DB_PATH=./data/broker.db

# --- Broker ---
SMB_VISIBILITY_TIMEOUT_SEC=30
SMB_MAX_ATTEMPTS=5
SMB_BACKOFF_BASE_SEC=5
SMB_BACKOFF_MAX_SEC=300
SMB_RETENTION_DAYS=7

# --- Rate limiting ---
SMB_RATE_LIMIT_PRODUCER_PER_MIN=120
SMB_RATE_LIMIT_CONSUMER_PER_MIN=240
SMB_RATE_LIMIT_LOGIN_PER_MIN=10
SMB_LOCKOUT_FAILS=5
SMB_LOCKOUT_WINDOW_SEC=900
